    {
      "parameters": {
        "jsCode": "const noticias = $input.all().map(item => item.json);\n\nif (noticias.length === 0) {\n  return [];\n}\n\nconst linhas = noticias.map(n => `\n  <li>\n    <strong>${n.title}</strong><br>\n    <small>${n.pubDate || ''}</small><br>\n    <a href=\"${n.link}\">Ler notícia</a>\n  </li>\n`).join('');\n\nreturn [{\n  json: {\n    assunto: `Resumo de notícias: ${noticias.length} novas`,\n    html: `<h2>${noticias.length} nova(s) notícia(s)</h2><ul>${linhas}</ul>`\n  }\n}];"
      },
